# Vinted Auto Listing Tool V2 – Beispielkonfiguration
#
# API-Keys können entweder in der App unter „Einstellungen“ eingetragen werden
# (dort werden sie verschlüsselt in der lokalen SQLite-Datenbank gespeichert)
# oder als Umgebungsvariablen gesetzt werden. Die Umgebungsvariable wird nur
# verwendet, wenn in der App kein Key hinterlegt ist.
#
# Diese Datei als ".env" kopieren und ausfüllen. ".env" ist in .gitignore
# eingetragen und darf niemals committet werden.

# OpenRouter (empfohlen: ein Anbieter, viele Modelle)
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Lokales, OpenAI-kompatibles Modell (Ollama, LM Studio, llama.cpp).
# Die meisten lokalen Server brauchen keinen Key – dann leer lassen.
LOCAL_AI_API_KEY=

# Optional: eigener Datenordner (Datenbank, Bilder, Logs, Exporte).
# Standard ist %APPDATA%\VintedAutoListingTool unter Windows.
# VINTED_TOOL_DATA_DIR=
